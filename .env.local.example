# Sanity (需要,填完後前端頁面才會從 Sanity 取資料)
NEXT_PUBLIC_SANITY_PROJECT_ID=h5qop6xy
NEXT_PUBLIC_SANITY_DATASET=production

# 只有 migration + Studio 寫入需要 (從 sanity.io/manage → API → Tokens 產)
SANITY_API_WRITE_TOKEN=

# 來源 Supabase (從 product-upload-site/void-store-render.env 複製過來即可)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_PRODUCTS_KEY=products.json

# 網站 admin 登入密碼 (自訂)
ADMIN_PASSWORD=admin123
